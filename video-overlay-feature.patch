+            mipmap: false
+            smooth: true
+            antialiasing: true
+            
+            onStatusChanged: {
+                if (status === Image.Error) {
+                    console.warn("Failed to load overlay image:", source)
+                } else if (status === Image.Ready) {
+                    console.log("Overlay image loaded successfully:", source)
